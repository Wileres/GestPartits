APP_NAME=GestPartits
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://partits.example.org
# Zona horària del club (dates i hores dels partits). L'aplicació desa les marques de temps en UTC.
CLUB_TIMEZONE=Europe/Madrid

APP_LOCALE=ca
APP_FALLBACK_LOCALE=ca
APP_FAKER_LOCALE=es_ES

APP_MAINTENANCE_DRIVER=file

# Només si hi ha un proxy invers davant (balancejador amb HTTPS): IP separades per comes.
TRUSTED_PROXIES=

# Contrasenyes: Argon2id
HASH_DRIVER=argon2id

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

DB_CONNECTION=mariadb
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=gestpartits
DB_USERNAME=gestpartits
DB_PASSWORD=

# Sessions: cookie HttpOnly + Secure + SameSite, contingut xifrat
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

# Dominis des d'on la SPA fa peticions amb cookies (sense esquema)
SANCTUM_STATEFUL_DOMAINS=partits.example.org

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

# Correu (PHPMailer per SMTP)
MAIL_MAILER=phpmailer
MAIL_HOST=smtp.example.org
MAIL_PORT=587
# tls (STARTTLS), ssl (SMTPS) o buit
MAIL_ENCRYPTION=tls
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_TIMEOUT=15
MAIL_FROM_ADDRESS="no-respongueu@example.org"
MAIL_FROM_NAME="${APP_NAME}"

# Usuari inicial (només per al primer `php artisan db:seed`).
# Esborreu INITIAL_USER_PASSWORD del .env un cop creat l'usuari.
INITIAL_USER_USERNAME=Gestor
INITIAL_USER_NAME=Gestor
INITIAL_USER_EMAIL=
INITIAL_USER_PASSWORD=

# WhatsApp
# Proveïdor per defecte: manual | gateway | log
WHATSAPP_DEFAULT_PROVIDER=manual
# Simulació (només per a proves; en producció queda desactivada si no s'indica).
WHATSAPP_LOG_ENABLED=false
# Passarel·la no oficial (via B). Desactivada per defecte: incompleix les condicions de WhatsApp
# i pot provocar el bloqueig del número. Activeu-la només amb un número dedicat del club.
WHATSAPP_GATEWAY_ENABLED=false
WHATSAPP_GATEWAY_URL=
WHATSAPP_GATEWAY_TOKEN=
# WhatsApp Business Platform (Meta): només números de telèfon, amb plantilles aprovades.
WHATSAPP_META_ENABLED=false
WHATSAPP_META_PHONE_NUMBER_ID=
WHATSAPP_META_TOKEN=
# Twilio per a WhatsApp: només números de telèfon.
WHATSAPP_TWILIO_ENABLED=false
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=

# Imatges
# chromium (recomanat) o gd (sense Chromium)
IMAGE_RENDERER=chromium
CHROMIUM_BINARY=/usr/bin/chromium
GD_FONT_REGULAR=/usr/share/fonts/truetype/dejavu/DejaVuSans.ttf
GD_FONT_BOLD=/usr/share/fonts/truetype/dejavu/DejaVuSans-Bold.ttf
IMAGE_KEEP_DAYS=90

VITE_APP_NAME="${APP_NAME}"
